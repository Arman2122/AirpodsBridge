[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ManufacturerName%
CatalogFile = BthAapBridge.cat
DriverVer   = 11/20/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
BthAapBridge.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...17763

[Standard.NTamd64.10.0...17763]
%DeviceDesc% = BthAapBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}

[BthAapBridge_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
BthAapBridge.sys

[BthAapBridge_Device.NT.Services]
AddService = BthAapBridge,%SPSVCINST_ASSOCSERVICE%,BthAapBridge_Service_Inst

[BthAapBridge_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\BthAapBridge.sys

[BthAapBridge_Device.NT.Wdf]
KmdfService = BthAapBridge, BthAapBridge_wdfsect

[BthAapBridge_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "AirpodsBridge"
DiskName               = "AirpodsBridge AAP L2CAP Bridge Installation Disk"
DeviceDesc             = "AirpodsBridge Apple Accessory Protocol (AAP) L2CAP Bridge"
ServiceDesc            = "AirpodsBridge AAP L2CAP Profile Driver"
