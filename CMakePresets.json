{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "dev",
      "inherits": "windows-base",
      "displayName": "Developer build (x64)",
      "description": "Native x64 build with tests enabled and a console attached.",
      "cacheVariables": {
        "APB_BUILD_TESTS": "ON",
        "APB_ENABLE_CONSOLE": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "windows-base",
      "displayName": "Release build (x64)",
      "description": "Native x64 release build with tests and the NSIS installer.",
      "cacheVariables": {
        "APB_BUILD_TESTS": "ON",
        "APB_GENERATE_INSTALLER": "ON"
      }
    },
    {
      "name": "release-arm64",
      "inherits": "windows-base",
      "displayName": "Release build (ARM64)",
      "description": "Native ARM64 release build cross-compiled with Qt 6 ARM64 + QT_HOST_PATH.",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "cacheVariables": {
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "APB_BUILD_TESTS": "OFF",
        "APB_GENERATE_INSTALLER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "release-arm64",
      "configurePreset": "release-arm64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
